# copy to .env (never commit .env)
ELITE_DOMAIN=play.example.com
ELITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
ELITE_SUPABASE_ANON=YOUR_PUBLIC_ANON_KEY
# clients older than this build are told to update (data/build_info.json "build")
ELITE_MIN_BUILD=0
# optional closed beta: a file inside the container with one email or account id per line
# ELITE_ALLOWLIST=/var/lib/elite/allowlist.txt
