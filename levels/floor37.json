  "lore": {
    "A": {
      "title": "Thread Under the Boot",
      "text": "Each step plucks a thread. Somewhere below, something feels it; walk slow and the web lets you; run and it knows. I ran, once."
    },
    "Y": {
      "title": "The Loom Hall Ledger",
      "text": "Thirty looms, bone frames, black thread. The weavers made cloth for the dead; they were paid in grain. The last bolt on the oldest loom was never cut; do not cut it."
    },
    "R": {
      "title": "A Second Pulse",
      "text": "Spun silk carries a beat, if you press it to your wrist. Slower than yours; match it and your own heart slows too. The weavers sat like this for hours; try it before a fight.",
      "teaches": "silk_art_2"
    },
    "G": {
      "title": "Silkworm Shelves",
      "text": "Shelves of worms, still alive, still eating. Someone feeds them; we never found who; take nothing from the shelves. The cocoon store is the safe place for supplies."
    },
    "M": {
      "title": "Weavers' Rest, Cot Count",
      "text": "Eleven cots, ten blankets. One cot unmade. One weaver did not rest; she went down to the pattern room and did not come back."
    },
    "O": {
      "title": "Pattern Library Shelf",
      "text": "The library holds the patterns of the web; each is a map of one floor; a weaver who reads them could walk without waking the Queen. I tried. I woke the Queen."
    },
    "U": {
      "title": "Clean Corner",
      "text": "There is a corner with no web; every other corner is thick. Somebody sweeps it; do not ask who. Sleep there if you must, and keep one hand on a blade."
    },
    "X": {
      "title": "The Weaver Queen",
      "text": "She is not a spider. She was a woman once, a weaver of the first age, and she wove herself in. She still sings while she works; do not listen to the end of the song."
    }
  },
  "riddles": {
    "?": {
      "title": "The Weaver's Question",
      "question": "I am made of thread but never worn. A hunter spins me, then waits. What am I?",
      "options": [
        "A cloak",
        "A web",
        "A rope"
      ],
      "answer": 1,
      "reward": {
