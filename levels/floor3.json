  "lore": {
    "R": {
      "title": "A Miner's Prayer",
      "text": "'Mother Earth, keep the roof above us and the water below us, and show your silver to honest hands.' Someone has scratched beneath it: the water did not stay below. Read it slowly, and the veins in the rock seem to lean toward you.",
      "teaches": "silver_vein"
    },
    "A": {
      "title": "Chalk on the Lamp-Room Wall",
      "text": "In a steady hand: SEAM CLOSED BY ORDER OF THE FOREMAN. WATER IN THE LOWER GALLERIES. Below it, in a hand that was not steady at all: he would not let us leave."
    },
    "F": {
      "title": "The Relic of Preservation",
      "text": "Here, the ancient fisherman's lantern still casts flickering light over the waterlogged barrels and crates. A corroded silver key hangs by a frayed string, said to unlock the storeroom's secret of eternal freshness."
    },
    "J": {
      "title": "The Forgotten Floodwaters",
      "text": "Once a place to store dry goods, the cellar now holds the briny waters that seep in through the cracked walls. A single candle flickers, its light barely reaching the soaked barrels and crates that line the walls."
    },
    "N": {
      "title": "The Lost Records",
      "text": "Ancient scrolls and parchments, now waterlogged and illegible, once held the secrets of the mine's deepest mysteries. Miners whispered that these records could reveal the location of untapped veins of precious metals, but the water has claimed the knowledge."
    }
  },
  "inheritances": {
    "I": {
      "master": "The Drowned Alchemist",
      "text": "A drowned figure sits cross-legged in a dry corner the water never reached. \"I brewed pills against the damp for three hundred miners, and none against my own foolishness. Take my pendant. Jade remembers water, and will not let it have you.\"",
      "grants": {
        "items": {
          "jade_pendant": 1
        }
      },
      "hidden": true,
      "needs_realm": 1
    }
  },
  "riddles": {
    "?": {
      "title": "The Drowned Bell",
      "question": "I have a tongue but cannot taste. I called the faithful but cannot walk. The water took my voice. What am I?",
      "options": [
        "A miner",
        "A bell",
        "A river"
      ],
      "answer": 1,
