  "lore": {
    "A": {
      "title": "The Stormcaller's Warning",
      "text": "We built the spire to catch the storm and keep it. We caught it. Now it keeps us. Do not touch the rods with bare hands, and do not stand under the crown when it glows."
    },
    "Y": {
      "title": "Burned Into a Door",
      "text": "SHE LAUGHS WHEN IT THUNDERS. THE TYRANT LAUGHS. RUN WHEN YOU HEAR HER LAUGH."
    },
    "R": {
      "title": "The Grounding Chamber",
      "text": "The stormcallers' last discipline: be the gap between the cloud and the ground. The bolt does not hesitate there, and neither should your hand.",
      "teaches": "storm_art"
    },
    "G": {
      "title": "The Echo of Prophecy",
      "text": "Here, the winds carry whispers of the future, tales of coming storms and fallen heroes. Sages listen in silence, seeking guidance in the chaotic patterns of the air."
    },
    "M": {
      "title": "The Secrets of the Storm",
      "text": "Below the thundering hallways lies this hidden cellar, where the whispers of ancient storms are stored in eerie silence. Here, the stormcaller's secrets and forbidden lore are kept, a place of quiet reverence amidst the chaos above."
    },
    "O": {
      "title": "The Reverberant Whisper",
      "text": "Here, the echoes of thunder and the whispers of storm spirits mingle, creating a cacophony that only the most attuned can decipher. Legend speaks of a lost treasure hidden in the heart of the cavern, revealed only to those who can hear the storm's secret language."
    },
    "U": {
      "title": "The Windrunner's Perch",
      "text": "Here, the winds are tamed by the skilled runners who navigate the spire's corridors with grace, leaving no trace of their passage but the soft rustle of garments swept by the currents."
    },
    "X": {
      "title": "The Sound of Wind",
      "text": "Those who pass through here hear a mournful whistle, as if the spire itself is sighing. The wind carves the stone into thin, hollow tubes, each one resonating with the gusts of the eternal storm."
    }
  },
  "riddles": {
