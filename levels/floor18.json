  "lore": {
    "A": {
      "title": "The Foreman's Log",
      "text": "The star fell before there were sects. We dig it because it is the finest iron there is. The men who dig too deep come back up humming, with stars in their eyes. Then they stop coming back up."
    },
    "Y": {
      "title": "A Prayer Chalked at the Shaft",
      "text": "Star above, you fell for us. Don't make us fall for you. Keep the roof up, keep the air sweet, and let us go home humming only the songs we came down with."
    },
    "R": {
      "title": "The Star's Heart Chamber",
      "text": "The oldest miners say the star is not dead, only sleeping, and that whoever sits by its heart long enough grows heavy with its iron. They are right.",
      "teaches": "starmine_art"
    },
    "G": {
      "title": "Whispers of the Ancients",
      "text": "In the shadows of the towering spires, miners whisper tales of the fallen star's secrets. Echoes of ancient chants can be heard at midnight, guiding those who dare to listen deeper into the mysteries of the mine."
    },
    "M": {
      "title": "The Relic of Blacksmith Varrick",
      "text": "Here, in the shadows of the mine, the ancient forge of Varrick still smokes, a testament to his lost art. Legend whispers that his spirit haunts this place, guiding the hammer of any who dare to shape star-iron."
    },
    "O": {
      "title": "The Legend of the Lost Lode",
      "text": "Here, miners whisper of a vein of star-iron, hidden deep within the fallen star's core. Legends speak of its discovery and subsequent mysterious disappearance, leaving only tales and the occasional shimmer of metal dust in the air."
    },
    "U": {
      "title": "The Echo of the Fallen",
      "text": "Miners whisper tales of a voice that echoes through these tunnels, a remnant of the star that once fell. Some say it guides lost souls back to the surface, others that it foretells the fate of the mine."
    },
    "X": {
      "title": "A Miner's Solitude",
      "text": "Lonely miners carved messages into the walls, sharing tales of home and dreams of escape, their voices echoing through the darkness."
    }
  },
  "riddles": {
    "?": {
      "title": "The Riddle of Impact Cavern",
      "question": "I fell from the sky but I am not rain, I burned on the way but I am not ash. What am I?",
