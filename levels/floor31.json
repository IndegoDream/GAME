  "lore": {
    "A": {
      "title": "Heat Under the Boots",
      "text": "The steps here are scale, not stone; they are warm. Rhee's second scout wrote on the wall: do not stand still on them; he did not say why. I stood still; I know why."
    },
    "Y": {
      "title": "Priest's Tablet, Cracked",
      "text": "BREATH COMES AFTER THE ROAR, NOT BEFORE. When you hear her gather air, you have two heartbeats. Get behind a rib; stone does not cook as fast as skin."
    },
    "R": {
      "title": "Scratched Under a Rib",
      "text": "Her breath ran along the spine, rib to rib, the way ours runs through the body. The priests learned to send theirs the same road, in order, and burned what they struck. Sit and follow it down.",
      "teaches": "dragonspine_art_2"
    },
    "G": {
      "title": "A Map Note, Pencil",
      "text": "Spinal Bridge is narrow and the bats like it. Take the Hall of Guardians instead. It is longer, but the guardians only walk one way, and it is not toward you."
    },
    "M": {
      "title": "Smith Hale's Mark",
      "text": "Hale's old tally mark, three bars and a hook; he came this far with the first lot, forty years back. Under it: a loose scale in the wall leads toward the heart. Quiet niche, east side."
    },
    "O": {
      "title": "Hunters' Count",
      "text": "Drakelings hatch in the pools; the big ones guard the hatchery. We burned two nests and thought we were clever. The next day there were four; leave the eggs alone."
    },
    "U": {
      "title": "Last Words, Vertebra Hall",
      "text": "I counted her ribs to keep my head. Forty-one; then she breathed and the count did not matter. If you found this, tell the Lodge that the brute at the hall's end does not tire."
    },
    "X": {
      "title": "A Child's Rhyme",
      "text": "One for the scale and two for the bone, three for the flame that will take you home. Four for the dream you must not wake. Five is the heart, for goodness' sake; Scratched low, where a child could reach."
    }
  },
  "riddles": {
    "?": {
      "title": "The Rib's Question",
      "question": "Many of us curve in two rows around a heart. We have no lock, yet we guard what is inside. What are we?",
      "options": [
        "A row of gates",
        "A ribcage",
        "A set of horns"
      ],
      "answer": 1,
      "reward": {
