  "lore": {
    "A": {
      "title": "The Gear Hall Rule",
      "text": "Walk where the floor is worn. The worn plates are the safe ones. The bright ones were laid after the machine woke and do not like weight."
    },
    "Y": {
      "title": "Sketches of Beetles",
      "text": "Plans pinned to the wall, one beetle after another. Each one smaller than the last. The last page says, they built themselves from here."
    },
    "R": {
      "title": "Clockmaker's Notebook",
      "text": "Page nine, underlined twice: nothing in a machine moves alone. Find its beat, strike on the beat, and it will carry the blow for you.",
      "teaches": "clockwork_art_3"
    },
    "G": {
      "title": "Shift Board",
      "text": "A tally of shifts, names beside them. The names stop partway down the board. Only the machine kept working through the night."
    },
    "M": {
      "title": "The Hour Bell",
      "text": "A bell hangs above the hall. It rang once an hour for as long as anyone lived here. If it rings now, count the strokes and move before the last."
    },
    "O": {
      "title": "Maker's Mark",
      "text": "Stamped on every gear: made to last forty years. A later hand scratched under it: it has. Somebody at least was pleased."
    },
    "U": {
      "title": "The Clockmaker's Quill",
      "text": "The quill is still wet. His last entry says he meant to turn the gears back and fix one day of the war. He did not say which day."
    },
    "X": {
      "title": "Spring Room Warning",
      "text": "Loud in here, from the springs. Stay clear when they unwind. A loose spring this size will take a man's arm off, and a careful man's arm too."
    }
  },
  "riddles": {
    "?": {
      "title": "The Clockmaker's Question",
      "question": "I have hands but cannot clap, and a face that never smiles. I run all day and never leave my place. What am I?",
      "options": [
        "A clock",
        "A scarecrow",
        "A mirror"
      ],
      "answer": 0,
