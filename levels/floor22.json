  "lore": {
    "A": {
      "title": "Weaver's Count",
      "text": "Forty looms in this hall and thirty-nine weavers still working. The fortieth chair is warm. Do not sit in it."
    },
    "Y": {
      "title": "Tied and Tagged",
      "text": "A bundle wrapped so tight the cord has cut into the cloth. A tag reads: the thing inside is the weaver's. Cut the knots in the order they were tied, or the web notices."
    },
    "R": {
      "title": "Weavers' Thread-Sense",
      "text": "Hold one thread loosely. Feel it hum when a spider crosses the far end. The weavers learned to feel the whole web through a single strand. Stand still and let the threads tell you where things are.",
      "teaches": "silk_art"
    },
    "G": {
      "title": "Spindle Song",
      "text": "Turn left, turn right, draw the thread. A skipping rhyme scratched on a spindle. The last verse says: step on silk and the silk steps back."
    },
    "M": {
      "title": "The Spindle Speaks",
      "text": "If a spindle hums at night, someone is walking the web. The hum gets louder as they get closer. Spindlers who ignored it were found wrapped and standing upright."
    },
    "O": {
      "title": "Knotted for Luck",
      "text": "Weavers tied their worries into the thread and sent them down the hall. I untied one and nothing happened. I am still waiting."
    },
    "U": {
      "title": "First Cloth",
      "text": "The first thing woven here was a flag. After it, a shroud. After that, they stopped keeping count of what they made. Mo said cloth outlasts the hand."
    },
    "X": {
      "title": "The Hub of the Web",
      "text": "All the threads in these halls run to one place. Pull one and the others move. A hunter's mark beside the loom says: cut the weakest and leave the rest."
    }
  },
  "riddles": {
    "?": {
      "title": "The Loom-Mother's Question",
      "question": "I spin a house from my own body and hang it in the air. Those who visit become my supper.",
