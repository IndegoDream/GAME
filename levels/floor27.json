  "lore": {
    "A": {
      "title": "The Flooded Stair",
      "text": "The steps are slick with brine and the fourth one is gone. Hold the left rail. A mason's chalk reads: low tide at the second bell."
    },
    "Y": {
      "title": "The Throne in the Water",
      "text": "The ballroom is under three feet of seawater now. Chandeliers hang above it, dry and still lit. The throne on the dais has a high-water mark halfway up its back."
    },
    "R": {
      "title": "Half-Buried in Coral",
      "text": "Breathe as the tide does. In slow and out slow, and the water holds you up instead of pulling you under. A courtier cut the lesson into the stone before the flood took him.",
      "teaches": "drowned_art_2"
    },
    "G": {
      "title": "A Courtier's Letter",
      "text": "Dearest Marin, the sea has come to the cellars. The Empress says it is a gift. I say she has not looked at the cellars. Bring your boots."
    },
    "M": {
      "title": "Reef Warning",
      "text": "The coral grows toward the living. It is faster than it looks. If a wall you passed is closer on the way back, do not go back that way."
    },
    "O": {
      "title": "The Short Way",
      "text": "Someone found a shortcut through the coral maze. Someone else found him in it. The coral turns with the current. Take the long way, and keep the water on your left."
    },
    "U": {
      "title": "A Pearl Diver's Count",
      "text": "Twenty breaths down, twenty up. The Court paid by the pearl, not by the day. Some of the divers are still counting."
    },
    "X": {
      "title": "The Empress's Altar",
      "text": "The Empress held court here under the water, among coral grown into altars. Her crown is not on the dais. A pearl diver's note says: look where the tide pools collect."
    }
  },
  "riddles": {
    "?": {
      "title": "The Tidewrecked Question",
      "question": "I arrive twice a day without being called. I take what I please and give back what I like. The moon holds my leash.",
      "options": [
        "A river",
        "The tide",
        "A storm"
      ],
