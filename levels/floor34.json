  "lore": {
    "A": {
      "title": "Stair That Hums",
      "text": "Every step rings a small note. Walk heavy and the notes pile up, and then the cave answers. Walk soft, on the edge of the step, and the cave lets you pass."
    },
    "Y": {
      "title": "Tuning Fork Rule",
      "text": "Do not strike the forks. Crystal here wants to ring, and the more it rings the louder the wisps get. Leave them be; carry no metal in your hand if you can help it."
    },
    "R": {
      "title": "The Cracked Lens",
      "text": "Hold a shard to the lamp and the light splits in seven. One strand is yours; follow it back and you find where you started, and who. The old delvers called it the road home.",
      "teaches": "crystal_art_2"
    },
    "G": {
      "title": "Names on the Wall",
      "text": "Someone scratched a name a hundred times; another has scratched the same name beneath. The first is the woman who walked in. The second is her daughter, who came to look; neither has a third."
    },
    "M": {
      "title": "Quiet Chamber Law",
      "text": "The vault is dead silent; if you speak low, the cave repeats it back a moment late. Say a name aloud and you will hear it answered. I advise you not to say a name."
    },
    "O": {
      "title": "The Choir Barracks",
      "text": "The barracks hold stone figures in rows, mouths open; when one cracks, the sound wakes the others. Break them one by one, not in a pile. Sound carries here."
    },
    "U": {
      "title": "Wisp Hatchery Note",
      "text": "Wisps are born in the geode and drift out. They are drawn to noise; be quiet and they pass you by. A loud man gets a ring of them; they do not bite; they only follow."
    },
    "X": {
      "title": "Queen's Resonance",
      "text": "At the bottom the queen sings one note, low, under your feet. It is not a song; it is more like a tooth being pulled; plug your ears if you have wax. I had none."
    }
  },
  "riddles": {
    "?": {
      "title": "The Chime's Question",
      "question": "I speak without a mouth and answer only when you call. What am I?",
      "options": [
        "A ghost",
        "A bell",
        "An echo"
      ],
      "answer": 2,
