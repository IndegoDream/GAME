  "lore": {
    "R": {
      "title": "The Monk's Stone",
      "teaches": "iron_skin",
      "text": "Before the goblins, monks dug these halls to sit closer to the old machines.\n\n'Breathe in until the breath is heavy. Hold it under the skin. Let the blow land on the breath, not on you.'"
    },
    "F": {
      "title": "The Last Shelf",
      "text": "One stone tablet survived the rot, propped where a shelf once stood:\n\n'Fire forged in water does not break. Metal cut from wood does not bend. Every strength has a thing it fears and a thing it feeds. Learn both, and you will not be surprised by yourself.'"
    },
    "M": {
      "title": "A Monk's Lament",
      "text": "Scratched beside a sleeping mat, small and neat:\n\n'Brother Haan went down past the hall and did not come back. Brother Ilse says the sage below will not speak to anyone who has not first learned to see. I think the sage is only bones. I think I am afraid that he is not.'"
    },
    "Y": {
      "title": "Scratched Carving",
      "text": "Goblin scratches cover an older carving. You can make out a figure stepping sideways out of a sword's path, its feet drawn as gusts of wind.\n\nUnderneath, in goblin: 'BIG ONE MOVE FUNNY. WATCH IT.'"
    }
  }
