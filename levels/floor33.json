  "lore": {
    "A": {
      "title": "Mind the Ninth One",
      "text": "The hall has many of you. Eight of them copy you; the ninth does not; go slow. Raise your left hand and see who is slow to answer; strike that one."
    },
    "Y": {
      "title": "Infinite Room, Notice",
      "text": "Nobody has walked this room to the end, because it has none. A man tied a rope to the door and played it out. He came back with the rope and no memory of why; keep your hand on the wall."
    },
    "R": {
      "title": "Under the Silver, a Line",
      "text": "The surface only shows what stands in front of it. The thing that looks back is not you, so it cannot hurt you the way you fear. Look past it, and what is beneath you holds; sit with your eyes open.",
      "teaches": "mirror_art_2"
    },
    "G": {
      "title": "Silversmith's Receipt",
      "text": "Received: six mirrors, quicksilver backed, one cracked in transit. Paid in full; the seller says the cracks were there before the glass was made. We did not argue; store unsold stock below."
    },
    "M": {
      "title": "Quicksilver Vein, Keep Out",
      "text": "Do not touch the vein with bare hands; it looks like silver and moves like water. Smiths who ignored this shook for a month. Hale says wear gloves, and wash after."
    },
    "O": {
      "title": "Hall of Doors Note",
      "text": "Most doors are painted on. Knock first; a painted door rings like a plate; a real door sounds like a closet. I learned this after the third bruise."
    },
    "U": {
      "title": "The Room With No Reflection",
      "text": "Step into it and you will see the room but not yourself; stay calm; it is only the glass that is missing. Elder Mo said some come out different. I came out the same, I think."
    },
    "X": {
      "title": "Cat's Corner",
      "text": "A cat lives here; it is not a real cat. It sits on the broken frame and watches us fight ourselves. It is the only thing on the floor that is exactly one thing."
    }
  },
  "riddles": {
    "?": {
      "title": "The Cracked Question",
      "question": "I am always in front of you, yet you can never reach me.",
      "options": [
        "A wall",
        "The future",
        "A shadow"
      ],
      "answer": 1,
