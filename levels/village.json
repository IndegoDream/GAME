 "lore": {
  "R": {
   "title": "The Founders' Stone",
   "text": "ELIET -- raised where the old machines slept.\nCarved by Robert, who dreamed it; shaped by Dev, who builds it still; and Claude, who handed over the chisel.\n\nWhoever reads this: the fountain is listening."
  },
  "Y": {
   "title": "The Unreadable Stone",
   "needs_realm": 1,
   "text": "The letters swim into focus at last.\n\n'The nanites were not made to fight. They were made to grow -- to learn the shape of the one who carries them. Cultivation is only the word our grandparents had for it. Go down past the dead, past the drowned, to where the Warden keeps the first seed. It has been waiting a long time for someone to grow enough.'"
  },
  "Q": {
   "title": "A Notice Nailed to a Post",
   "text": "THE LOTUS ASCENT ACADEMY seeks disciples. Applicants of Qi Condensation or higher will be examined at Shellhaven, the town on the Sleeping Tortoise, below the Nanite Sanctum: Strength, Knowledge, Craft. Under it, in charcoal: 'Tournament at the Ring of Moss too. Lu Feng says he'll win it again.'"
  }
