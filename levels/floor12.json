  "lore": {
    "A": {
      "title": "The Hunter's Carving",
      "text": "The canopy is not a forest. The canopy is one animal, and we are walking inside it. It has been very patient with us. It will not be patient forever."
    },
    "Y": {
      "title": "Notched Into a Trunk",
      "text": "Seven hunters came in. Count the notches. I am the seventh notch. If you are reading this, cut the eighth for yourself -- and then prove it wrong."
    },
    "R": {
      "title": "The Matriarch's Seed",
      "text": "The canopy taught its hunters one thing: the strongest strike is the one you waited for. Wait longer than your prey, and you will never need a second.",
      "teaches": "canopy_art"
    },
    "G": {
      "title": "A Safe Haven",
      "text": "Here, the vines are thick and the whispers of the canopy are hushed. This is where the elders meet, their secrets and council guarded by the tightest of knots and the most intricate of weavings."
    },
    "M": {
      "title": "The Voice of the Forest",
      "text": "Here, the wind carries secrets of the deep woods. Listen closely and you may hear the cries of the lost and the whispers of the wise."
    },
    "O": {
      "title": "The Weaver's Warning",
      "text": "Beware the shadows that whisper secrets of the night. Here, the weaver's loom waits, its threads entangled with tales of those who dared to tread where light fears to go."
    },
    "U": {
      "title": "The Keeper of Secrets",
      "text": "Here, the vines and leaves entwine to form a labyrinthine tapestry, where the whispers of the forest carry secrets of the past. Those who listen closely may hear the tales of long-lost hunters and ancient battles fought within the Crimson Canopy's embrace."
    },
    "X": {
      "title": "Whispers of the Ancients",
      "text": "Legends say this ancient tree holds the whispers of long-forgotten hunters, their voices carried by the wind through the hollows of its bark."
    }
  },
  "riddles": {
    "?": {
      "title": "The Riddle of Red Pool",
      "question": "I have a crown but no head, I grow but never move, and I drink with my feet. What am I?",
      "options": [
        "A tree",
        "A queen",
        "A beetle"
      ],
