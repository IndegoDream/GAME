  "lore": {
    "A": {
      "title": "Hum in the Stone",
      "text": "In the heart of the cavern the stones sing when you walk past. Stop moving and they quiet. Speed makes them louder, and louder is worse."
    },
    "Y": {
      "title": "Veins That Ring",
      "text": "Crystal veins run through the walls. They give back every blow you strike, and a hard blow comes back hard. Strike light near them. Strike true."
    },
    "R": {
      "title": "The Last Tuner",
      "text": "The last tuner wrote that a cavern keeps one note. Find it, hum it low, and your qi settles into it. Do not hold it long. It wants to be held.",
      "teaches": "crystal_art_3"
    },
    "G": {
      "title": "Silence Room",
      "text": "The one quiet room in the choir. The stones here stay still, and the tuners came here to rest their ears. Rest yours."
    },
    "M": {
      "title": "Choir Order",
      "text": "Painted on the wall, a seating plan. Sopranos by the east stones, bass by the west. Somebody has moved the bass. It sounds wrong, and that is why."
    },
    "O": {
      "title": "Tuning Fork, Left Behind",
      "text": "An iron fork, dented. Strike it and the room answers a half tone sharp. The tuners hated that. They never fixed it."
    },
    "U": {
      "title": "Singing Stones",
      "text": "The stones hum a different note in each passage. Follow the rising notes and you go deeper. Follow the falling ones and you come out."
    },
    "X": {
      "title": "A Weaver's Thread",
      "text": "Weavers once ran thread between the stones to hold the notes steady. The thread rotted, and the notes drift. The balance was theirs to keep. It was always work."
    }
  },
  "riddles": {
    "?": {
      "title": "The Tuner's Question",
      "question": "I am struck, yet I never fight. I ring clear when whole and flat when cracked.",
      "options": [
        "A drum",
        "A shield",
        "A bell"
      ],
      "answer": 2,
