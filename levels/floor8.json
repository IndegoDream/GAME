  "lore": {
    "Y": {
      "title": "The Emperor's Decree",
      "text": "BY ORDER: the army shall stand guard in death as in life. Every soldier shall be made in the likeness of a living man. Every living man shall be made into a soldier. -- the Third Year of the Endless Reign."
    },
    "R": {
      "title": "The General's Drill Book",
      "teaches": "terracotta_stance",
      "text": "Lesson one: a soldier who cannot be moved cannot be beaten. Plant your feet as if you had been fired in a kiln. Let them strike; clay does not flinch. Lesson two: do not become clay. The Emperor's soldiers forgot lesson two."
    },
    "F": {
      "title": "The Lost Wealth",
      "text": "Here lies the forgotten riches of ancient rulers, buried with their dreams and ambitions. Coins and jewels, once symbols of power and prestige, now rest silently under layers of earth and time."
    },
    "J": {
      "title": "Whispers of the Ancients",
      "text": "Here, the shadows hold the secrets of the Terracotta Army. At night, one can hear the faint murmurings of past generals, their voices carried by the cool, damp air of the crypt."
    },
    "N": {
      "title": "The Offering to the Earth Spirits",
      "text": "Here, the ancient priests would lay offerings to the earth spirits, hoping for bountiful harvests and protection from the gods. The clay altar, worn smooth by countless hands, bears the marks of both joyous celebrations and solemn prayers."
    },
    "Q": {
      "title": "The Echo of the Earth",
      "text": "Here, the spirits of the ancient potters linger, their whispers carried by the winds that pass through the cracks in the walls. The clay beneath your feet seems to pulse with their ancient secrets and the tales of a world long buried."
    }
  },
  "riddles": {
    "?": {
      "title": "The Offering Bowl",
      "question": "I was dug from the earth, shaped by hands, baked in fire and given a face. I have stood a thousand years and never taken a step. What am I?",
