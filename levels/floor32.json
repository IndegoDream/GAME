  "lore": {
    "A": {
      "title": "Sand Without Footprints",
      "text": "The slope is ash over glass; wind erases your trail in a minute. Cut a mark in the rock at every turn. I did not, and I walked past this stone three times."
    },
    "Y": {
      "title": "Count the Colossi",
      "text": "Colossus pens are east of the gallery. Each beast is as tall as a house and slow to turn. Strike the leg, step back, strike again; they forget you if you stay behind them."
    },
    "R": {
      "title": "Half-Buried, Half-Burnt",
      "text": "A glassmaker's note. Fire does not only cut; if you let the heat come and do not flinch, the skin learns it. It goes hard like a pot in the kiln; stand in the glow and breathe slow.",
      "teaches": "ash_art_2"
    },
    "G": {
      "title": "Caravan Ledger, Last Line",
      "text": "Forty camels; Twenty-two men. Salt, glass, two jars of lamp oil. Water: none; we took the wind corridor to save a day; it cost us the rest; do not trust a short road."
    },
    "M": {
      "title": "A Scrawl in the Shade",
      "text": "Do not drink from the Flooded Grotto; it looks clean. My brother drank; he talked to the wall for a night and then he stopped talking. Boil nothing; carry your own."
    },
    "O": {
      "title": "Ash Whirl Rule",
      "text": "When the ash starts to turn, stop; hold your sleeve to your face and wait; it passes in a dozen breaths. If you run, you run into the pits. I saw a man do it."
    },
    "U": {
      "title": "Mirage Warning",
      "text": "If the water shines, it is not water; real water does not shine, it sits. The Ashen Mirage has taken three of ours. It is a room, not a lake; walk through the glare and it ends."
    },
    "X": {
      "title": "The Ash King's Court",
      "text": "They say a king ruled here before the sand. His court is at the bottom, still sitting. One of the old Lodge men saw it; he said they all looked up when he came in; that was all he said."
    }
  },
  "riddles": {
    "?": {
      "title": "The Dune's Question",
      "question": "I am born of sand and fire, clear as water, yet hard and easily broken. What am I?",
      "options": [
        "Salt",
        "Ice",
        "Glass"
      ],
      "answer": 2,
