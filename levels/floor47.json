  "lore": {
    "A": {
      "title": "Fish Steps",
      "text": "Each stair has a fish cut into it. Step on the fish with its mouth open, never the shut ones. The wet is slippery and the water below is cold."
    },
    "Y": {
      "title": "The Empress's Puzzle",
      "text": "The Empress liked guests to earn the next room. Each door is a riddle. The coral walls carry the clues if you read them in order of tide."
    },
    "R": {
      "title": "The Breathing Statue",
      "text": "The statue's chest rises with the water outside. Breathe with it, in as the tide comes and out as it leaves, and the blows you strike will land the same way.",
      "teaches": "drowned_art_3"
    },
    "G": {
      "title": "Priestess's Pool",
      "text": "A shallow pool ringed with pearls. The priestesses kept silence here. The rule is cut on the rim: speak only after the water is still."
    },
    "M": {
      "title": "Tide Keeper's Rule",
      "text": "The tide keeper kept a log. Water high at dusk, water low at dawn, and the door at the west end opens only at the low. Never at the high."
    },
    "O": {
      "title": "The Queen's Pearl Room",
      "text": "A round room, the floor all pearl. Nothing here is guarded. Yet every delver who took one is on the wall, in a fresco, looking surprised."
    },
    "U": {
      "title": "Collector's Shelves",
      "text": "The Empress kept one of every shell her people ever found. Hundreds, labelled in a tiny hand. The labels say where and when, never why."
    },
    "X": {
      "title": "What the Court Kept",
      "text": "The Court sank slowly. The ledger notes each flooded hall, one by one. The last line is only: we kept the tide off for ninety years."
    }
  },
  "riddles": {
    "?": {
      "title": "The Empress's Question",
      "question": "I have a bed but never sleep, and a mouth but never eat. I run but never walk. What am I?",
      "options": [
        "A fish",
        "A lake",
        "A river"
      ],
      "answer": 2,
