  "lore": {
    "A": {
      "title": "The Sect Gate",
      "text": "THE SECT OF THE STANDING BLADE. One sword for every disciple, planted the day they took their vows, drawn the day they died. Look at the valley. Count the swords that were never drawn."
    },
    "Y": {
      "title": "Carved on the Meditation Cliff",
      "text": "Before the duel he sat here three days without moving. On the fourth day he stood and said: I have decided. That is all sword intent is -- a decision you do not take back."
    },
    "F": {
      "title": "The Forgotten Armory",
      "text": "Here lie the rusted blades and broken shields of warriors long since departed. Legends speak of a secret entrance hidden within the shadows, but few have returned to share the tale."
    },
    "J": {
      "title": "The Guardian of Whispers",
      "text": "Here, the air is thick with the silence of ancient secrets. A lone statue stands guard, its eyes forever closed, as if in eternal meditation. Legends speak of a voice heard by those pure of heart, guiding them through the deepest trials."
    },
    "N": {
      "title": "The Chamber of Forgotten Words",
      "text": "Here, the whispers of ancient battles linger, voices of the fallen echoing through the halls. Disciples often come to this place to listen and learn from the past, their own words blending with the echoes of history."
    },
    "Q": {
      "title": "Forgotten Ancestral Forge",
      "text": "Ancient runes etched into the walls whisper of forgotten forges, where the first blades of this realm were honed. The air is thick with the scent of cooled metal and the faint echo of hammer strikes long silenced."
    }
  },
  "inheritances": {
    "I": {
      "master": "the Sword Saint's Last Disciple",
      "hidden": true,
      "needs_realm": 3,
      "text": "An old woman sits with an empty scabbard across her knees. \"Sixty years I have waited for someone the Grave did not frighten off. My master's sword is gone -- he carried it into the duel he lost. His sheath remains, and his intent. Take both. And when you face his shade, do not hesitate. He never did.\"",
      "grants": {
        "items": {
          "saints_sheath": 1
        },
        "techniques": [
          "sword_intent"
        ],
        "qi": 800
      }
    }
  },
  "riddles": {
    "?": {
      "title": "The Graveyard Stone",
      "question": "I am drawn but never painted, sheathed but never dressed, and I have a point I never make in words. What am I?",
      "options": [
        "A brush",
        "A sword",
        "A wraith"
      ],
      "answer": 1,
