  "lore": {
    "A": {
      "title": "A Note Scratched in Glass",
      "text": "Do not hum. Do not whistle. The Queen listens for any song that is not hers, and she answers it."
    },
    "Y": {
      "title": "The Tuners' Rule",
      "text": "Every crystal here sings one note. The tuners came to find the one note that, struck, would bring the whole cavern down. They found it. That is why there are no more tuners."
    },
    "R": {
      "title": "The Hollow Note",
      "text": "The last tuner wrote: a meridian is a crystal too. Strike it true and it rings back -- every blow you give returns to you as strength. I learned it too late to use it.",
      "teaches": "crystal_art"
    },
    "G": {
      "title": "The Silent Reverberation",
      "text": "Here, the whispers of the past linger, echoing through the narrow corridors. Each step amplifies the sound, creating a symphony of forgotten voices and distant memories. Travelers speak in hushed tones, for the cloister listens and remembers all."
    },
    "M": {
      "title": "The Echo of the Past",
      "text": "Ancient whispers echo here, tales of forgotten lore and secrets lost to time. The cavern resonates with the voices of those who once sought enlightenment within these walls."
    },
    "O": {
      "title": "The Guardian's Song",
      "text": "Here, the ancient guardian of the caverns sings a song that calms the restless spirits and guides the lost souls back to their resting places."
    },
    "U": {
      "title": "The Scribe's Retreat",
      "text": "Here, the gentle hum of voices carries secrets etched into the walls. Scribes gather to share tales of the crystal caverns, each word resonating with the truth of their journey."
    },
    "X": {
      "title": "The Chime of Silence",
      "text": "Here, the echoes of the caverns cease, and a single chime resonates, silent yet loud, a paradox of sound and absence."
    }
  },
