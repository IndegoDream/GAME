  "lore": {
    "A": {
      "title": "A Courtier's Last Poem",
      "text": "We fell for a hundred days. On the hundred-and-first we landed, and learned that the ground had been waiting for us all along."
    },
    "Y": {
      "title": "The Edict of Heaven",
      "text": "BY THE EDICT OF HEAVEN, THIS PALACE SHALL NEVER FALL. -- and under it, carved by a mortal hand after the fall: Heaven was wrong."
    },
    "R": {
      "title": "The Heaven-Gate Fragment",
      "text": "On a broken piece of the gate to heaven: the immortals did not climb. They breathed until they were light enough to rise. Breathe like this, and you will rise too.",
      "teaches": "cloudruins_art"
    },
    "G": {
      "title": "Resonance of the Past",
      "text": "Legends whisper of a stair that echoes the steps of fallen immortals. Each tread resonates with their silent cries, a haunting melody only heard by those who seek the truth of the palace's downfall."
    },
    "M": {
      "title": "Echoes of Old Knowledge",
      "text": "Here, ancient scrolls and tomes whisper secrets to the wind, their pages etched with the wisdom of fallen scholars and forgotten sages. Those who seek understanding must listen closely, for the air itself carries the answers, but only to those with pure hearts and open minds."
    },
    "O": {
      "title": "Whispers of Departure",
      "text": "Carved into the cold stone, ancient runes speak of immortals who once danced here under the moonlit sky. Now, only faint echoes remain, telling tales of their final ascent to the heavens."
    },
    "U": {
      "title": "The Veil's Secret",
      "text": "A thin, shimmering veil separates this chamber from the rest of the palace. Those who whisper through it hear the distant echoes of ancient battles fought by long-forgotten immortals."
    },
    "X": {
      "title": "The Veil's Secret",
      "text": "Beyond the gossamer veil, whispers of ancient secrets and lost knowledge drift through the air. Those who listen closely may uncover truths long forgotten."
    }
  },
