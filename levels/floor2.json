  "lore": {
    "G": {
      "title": "The Crypt's Inscription",
      "text": "Cut deep by an unsteady hand: THE BONE LORD KEEPS HIS COURT BELOW. DO NOT WAKE THE KNIGHTS. DO NOT LISTEN TO THE WALL."
    },
    "R": {
      "title": "The Breathing Wall",
      "text": "Press your ear to it and the wall breathes: in, for a count of twelve; out, for a count of twelve. Someone cut grooves into the stone to match that breath, one for every count. Breathe with it long enough and your own breath stops hurrying.",
      "teaches": "mountain_breath"
    },
    "Y": {
      "title": "The Crypt's Story",
      "text": "Here lies the remains of the Bone Lord, a guardian of the crypt's secrets."
    },
    "F": {
      "title": "The Echo of Lost Souls",
      "text": "Voices whisper and weep in the narrow corridor, carrying tales of forgotten sorrow. Each step resonates with the cries of those who never found peace. The walls, lined with ancient runes, seem to pulse with the weight of unspoken grief."
    },
    "M": {
      "title": "Gloomshade Niche",
      "text": "Here, the shadows stretch like vines, wrapping around the walls and stealing the light. A single, flickering lantern hangs from the ceiling, its flame a beacon to those lost in the darkness. The niche whispers secrets of the past, but only to those who dare to listen."
    },
    "O": {
      "title": "The Echoes Within",
      "text": "Here, the walls hum with the faint whispers of those who mourned the dead. Bones and trinkets of the departed litter the floor, their stories hidden in the echoes of sorrow that linger in the air."
    }
  },
  "riddles": {
