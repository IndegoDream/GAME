  "lore": {
    "A": {
      "title": "Scratched on a Rib",
      "text": "She dreamed of me last night. I woke up with scales on my arms. Tonight I will try very hard not to sleep. I do not think it will matter."
    },
    "Y": {
      "title": "The Dragon-Priest's Warning",
      "text": "We walk on her spine. We live in her dream. Everything here -- the drakes, the guardians, the fire -- is something she is dreaming. Do not wake her. Do not let her dream of you."
    },
    "R": {
      "title": "The Heartbeat Chamber",
      "text": "Once a century her heart beats. The priests learned to breathe with it -- slow, enormous, hot -- and their strikes burned like her breath.",
      "teaches": "dragonspine_art"
    },
    "G": {
      "title": "A Mysterious Scent",
      "text": "The air here is heavy with the scent of old moss and forgotten secrets. A single, withered scale, crusted with age and decay, hangs from the ceiling like a silent warning."
    },
    "M": {
      "title": "Whispers of the Past",
      "text": "Here, the ancient scales of the dragon speak in hushed tones, recounting tales of battles long forgotten and heroes who walked these halls. Listen closely, for the whispers hold secrets that could guide you through the dungeon's trials."
    },
    "O": {
      "title": "The Vault of Scales",
      "text": "Here, ancient scales of the Dragon's molt are stored, each one a relic of power and protection. The air hums with a whisper of past battles and the scales' magic still guards their chamber."
    },
    "U": {
      "title": "The Listener's Domain",
      "text": "Here, the scales of the dragon's vast hide whisper secrets of forgotten ages. Legend speaks of a guardian who listens to these whispers and guards the secrets with a silent vigil."
    },
    "X": {
      "title": "The Scaled Sanctuary",
      "text": "Carved scales line the walls, whispering ancient secrets of the dragon's past. A single, glowing emerald egg lies in the center, watched over by silent, hooded figures who tend to the guardian's legacy."
    }
  },
