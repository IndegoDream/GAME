  "lore": {
    "A": {
      "title": "Stormglass Stair",
      "text": "The stair winds up through the spire. Lightning marks cut into each step still glow. They show which steps hold. The dark ones do not."
    },
    "Y": {
      "title": "The Gale Hall",
      "text": "The wind inside turns on itself and never settles. The walls were built to bend with it. Lean the way the wall leans and you will not be pushed off."
    },
    "R": {
      "title": "Boulder Under the Roof",
      "text": "A boulder with a cut line across it. Strike on the line and it rings. Keepers say the swiftest blow is the one that is already done when you see it.",
      "teaches": "storm_art_3"
    },
    "G": {
      "title": "Vault Door, Left Open",
      "text": "The vault was emptied in a hurry. Hinges melted by lightning. Whatever lived here left it open on purpose, or never meant to come back."
    },
    "M": {
      "title": "Rumble Stone",
      "text": "The thunder here is not a storm. It is old, and it comes from under the floor. Elder Mo's grandmother called it the world breathing."
    },
    "O": {
      "title": "Sky Watchers' Log",
      "text": "Lightning struck the spire eleven times today. We counted. Nobody was hurt, but Pell lost his eyebrows and has not stopped laughing."
    },
    "U": {
      "title": "Thunder-Iron Notes",
      "text": "A smith's recipe, torn: heat until it rings, quench in rain, never in a river. Lightning rods made this way do not melt. They sing."
    },
    "X": {
      "title": "The Anvil Bench",
      "text": "The anvil is cold, which is odd for a place so full of lightning. A smith's apron hangs from it. No one has ever claimed it."
    }
  },
