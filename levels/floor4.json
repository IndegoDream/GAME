  "lore": {
    "A": {
      "title": "Letters of Light",
      "text": "Letters of light still crawl across the lintel: THE WARDEN KEEPS THE SEED. THE SEED KEEPS THE WORLD. Below them, fainter, as if the light itself were tired: turn back, child of the surface. The Warden no longer knows you."
    },
    "Y": {
      "title": "The Archive of Hands",
      "text": "Rows of metal hands, palms up, each holding a sliver of something that hums. A plaque: HERE THE MAKERS GAVE THEIR NANITES TO THE SANCTUM, SO THE WARDEN COULD KEEP WHAT THEY COULD NOT. Scratched beneath it, much later: the Warden kept us too."
    },
    "R": {
      "title": "The Seed Vault's Hymn",
      "text": "No words here, only a hum -- and the shards in your blood answer it. Sit still and you can hear what the nanites were made for. Not to fight. To mend. To gather what is scattered.",
      "teaches": "nanite_resonance"
    },
    "F": {
      "title": "Whispers of the Ancients",
      "text": "Here, the voices of those who have walked these halls before linger, their whispers guiding the curious and warning the unwary. Each tome and scroll carries the weight of forgotten knowledge, a silent testament to the sanctum's enduring quest for understanding."
    },
    "J": {
      "title": "The Heart of Creation",
      "text": "Here, the eternal hum of machinery blends with the soft glow of nanite synthesis. The air is thick with the scent of ozone and the whispers of ancient knowledge, as the nanites weave the fabric of reality itself."
    },
    "N": {
      "title": "The Echoes of Forgotten Words",
      "text": "Here, the walls hum with the whispers of ancient lore, secrets passed down through the ages. Only those with the ears to hear and the courage to listen may uncover the truths hidden beneath the silence."
    }
  },
  "inheritances": {
    "I": {
      "master": "the Warden's Last Disciple",
      "hidden": true,
      "needs_realm": 2,
      "text": "A figure in a cracked mantle sits facing the wall, as if listening through it to the throne room beyond. \"I could not save my master from what the Sanctum made of him. Perhaps you can end it. Take my seat. Sit, and the petals will open for you as they opened for me.\"",
      "grants": {
        "items": {
          "lotus_seat": 1
        },
        "qi": 400
      }
    }
  },
